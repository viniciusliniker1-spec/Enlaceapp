{
  "id": "/app",
  "name": "Enlace - Organizador de casamento",
  "short_name": "Enlace",
  "description": "Fornecedores, pagamentos, convidados, convite digital, mesas, checklist e lista de presentes do casamento.",
  "lang": "pt-BR",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fbf7f1",
  "theme_color": "#3f5b4b",
  "categories": ["lifestyle", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Pagamentos", "url": "/app/financeiro", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Convidados", "url": "/app/convidados", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Presentes", "url": "/app/presentes", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": { "action": "/app/compartilhar", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } }
}
